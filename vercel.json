    {
      "source": "/contracts-client.js",
      "destination": "https://gamamc-site-production.up.railway.app/contracts-client.js"
    },
    {
      "source": "/contracts.css",
      "destination": "https://gamamc-site-production.up.railway.app/contracts.css"
    },
    {
      "source": "/audit-nav.js",
      "destination": "https://gamamc-site-production.up.railway.app/audit-nav.js"
    },
    {
      "source": "/audit-client.js",
