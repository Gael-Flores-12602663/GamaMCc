    },
    {
      "source": "/style.css",
      "destination": "https://gamamc-site-production.up.railway.app/style.css"
    },
    {
      "source": "/premium.css",
      "destination": "https://gamamc-site-production.up.railway.app/premium.css"
    },
    {
      "source": "/commerce.css",
      "destination": "https://gamamc-site-production.up.railway.app/commerce.css"
    },
    {
      "source": "/commerce-shop.js",
      "destination": "https://gamamc-site-production.up.railway.app/commerce-shop.js"
    },
    {
      "source": "/commerce.js",
      "destination": "https://gamamc-site-production.up.railway.app/commerce.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://gamamc-site-production.up.railway.app/assets/:path*"
    },
    {
      "source": "/comercios.html",
      "destination": "https://gamamc-site-production.up.railway.app/comercios.html"
    },
    {
      "source": "/commerce-admin.html",
      "destination": "https://gamamc-site-production.up.railway.app/commerce-admin.html"
    },
    {
      "source": "/politicas.html",
      "destination": "https://gamamc-site-production.up.railway.app/politicas.html"
    },
    {
      "source": "/convite.html",
      "destination": "https://gamamc-site-production.up.railway.app/convite.html"
    },
    {
      "source": "/ryvix.css",
      "destination": "https://gamamc-site-production.up.railway.app/ryvix.css"
    },
    {
      "source": "/ryvix-client.js",
      "destination": "https://gamamc-site-production.up.railway.app/ryvix-client.js"
    },
    {
      "source": "/commerce-admin.js",
      "destination": "https://gamamc-site-production.up.railway.app/commerce-admin.js"
    },
    {
      "source": "/contracts-nav.js",
      "destination": "https://gamamc-site-production.up.railway.app/contracts-nav.js"
